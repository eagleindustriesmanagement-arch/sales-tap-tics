{
  "name": "sales-tap-tics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage packages/rules packages/scoring packages/content packages/engine",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "content:validate": "tsx packages/content/scripts/validate.ts && tsx packages/rules/scripts/check-content.ts",
    "content:import-spec": "tsx packages/content/scripts/import-spec.ts",
    "i18n:check": "tsx packages/i18n/scripts/check.ts",
    "check": "pnpm typecheck && pnpm test && pnpm content:validate && pnpm i18n:check && pnpm web:typecheck",
    "web:typecheck": "pnpm --filter @taptics/web typecheck",
    "web:build": "pnpm --filter @taptics/web build",
    "db:migrate": "pnpm --filter @taptics/db migrate",
    "db:seed": "pnpm --filter @taptics/db seed",
    "db:publish-content": "pnpm --filter @taptics/db publish-content",
    "compliance:suite": "tsx packages/ai/scripts/compliance-suite.ts",
    "secret:scan": "tsx scripts/secret-scan.ts",
    "db:deploy": "pnpm --filter @taptics/db run release"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
